{
  "name": "fetch-toyota-service-manusls",
  "version": "1.0.0",
  "description": "Downloads HTML and PDF versions of Toyota Service Manuals from TIS",
  "main": "src/index.ts",
  "type": "module",
  "repository": "https://github.com/iamtheyammer/fetch-toyota-service-manuals",
  "author": "Sam <iamtheyammer@gmail.com>",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=24"
  },
  "private": false,
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "axios": "^1.20",
    "axios-cookiejar-support": "^7",
    "command-line-args": "^6",
    "command-line-usage": "^7",
    "dayjs": "^1.11.23",
    "playwright": "^1.63",
    "tough-cookie": "^6",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@types/command-line-args": "^5.2.3",
    "@types/command-line-usage": "^5.0.4",
    "@types/node": "^26",
    "@types/qs": "^6.15.1",
    "prettier": "^3",
    "typescript": "^5.9"
  },
  "scripts": {
    "start": "NODE_TLS_REJECT_UNAUTHORIZED=0 node src/index.ts",
    "start:inspect": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --inspect-brk src/index.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "extract-cookie": "node tools/extractCookie.ts",
    "lookup-codes": "NODE_TLS_REJECT_UNAUTHORIZED=0 node tools/lookupCodes.ts",
    "download-documents": "NODE_TLS_REJECT_UNAUTHORIZED=0 node tools/downloadDocuments.ts",
    "refresh-session": "NODE_TLS_REJECT_UNAUTHORIZED=0 node tools/refreshSession.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tools/**/*.ts\" \"test/**/*.ts\"",
    "playwright-setup": "playwright install chromium && playwright install-deps chromium",
    "watch": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --watch src/index.ts"
  }
}
